         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2027 Ageing Report. Underlying Assumptions &amp; Projection Methodologies</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This report details the underlying demographic and macroeconomic assumptions, as well as the projections methodologies that will be used for the update of the long-term budgetary projections of the 2027 Ageing Report, which will be published in spring 2027.</rdf:li>
            </rdf:Alt>
         </dc:description>
