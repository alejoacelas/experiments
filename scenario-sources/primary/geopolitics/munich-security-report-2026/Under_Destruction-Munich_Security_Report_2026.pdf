   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dr. Felix Klein, Federal Government Commissioner for Jewish Life in Germany and the Fight against Anti-Semitism, Jurgen Dusel, Federal Government Commissioner for Matters relating to Persons with Disabilities, Dr. Mehmet Daimaguler, Federal Commissioner against Antiziganism and for the Life of Sinti and Roma in Germany, Sven Lehmann, Federal Government Commissioner for the Acceptance of Sexual and Gender Diversity, Reem Alabali-Radovan, Federal Government Commissioner for Migration, Refugees and Integration and Commissioner for Anti-Racism, and Ferda Ataman, Independent Federal Commissioner for Anti-Discrimination, present the 5th report of the Federal Anti-Discrimination Agency in Berlin, Germany, on September 10. (Photo by Christian Marquardt/NurPhoto via Getty Images)</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Christian Marquardt/NurPhoto</rdf:li>
