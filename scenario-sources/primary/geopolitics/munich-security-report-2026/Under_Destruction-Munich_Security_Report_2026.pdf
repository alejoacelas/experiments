   <dc:subject>
    <rdf:Bag>
     <rdf:li>#MSC</rdf:li>
     <rdf:li>Munich Security Conference</rdf:li>
     <rdf:li>diplomacy</rdf:li>
     <rdf:li>formal discussion</rdf:li>
     <rdf:li>U.S. flag pin</rdf:li>
     <rdf:li>international relations</rdf:li>
     <rdf:li>classical interior</rdf:li>
     <rdf:li>sculptures</rdf:li>
     <rdf:li>conference setting</rdf:li>
